# ============================================================
# NEXUS KIDS ACADEMY — Variáveis de Ambiente (template)
# ============================================================
# Copie para .env.local e preencha com seus valores.
# NUNCA commitar .env, .env.local ou *.env.*.local.
# ============================================================

# ----- Next.js -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nexus Kids Academy

# ----- Supabase (Fase 2) -----
# Obter em: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Para gerar tipos: npx supabase gen types typescript --project-id=...
SUPABASE_PROJECT_ID=

# ----- Anthropic Claude API (Fase 5 — MENTOR IA) -----
# Obter em: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo padrão MENTOR (usar Haiku para custo)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----- RevenueCat (Fase 5/6 — IAP via lojas) -----
# Obter em: https://app.revenuecat.com
NEXT_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
NEXT_PUBLIC_REVENUECAT_APPLE_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ----- PostHog Analytics (Fase 5) -----
# Obter em: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----- Sentry Error Tracking (Fase 5) -----
# Obter em: https://sentry.io/settings/projects
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----- Resend Email (Fase 5) -----
# Obter em: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=naoresponda@kidsacademy.com.br

# ----- Capacitor (apenas build) -----
# Bundle IDs configurados em capacitor.config.ts
# CAPACITOR_ANDROID_KEYSTORE_PATH=
# CAPACITOR_ANDROID_KEYSTORE_PASSWORD=
